# ─── PatriMon — Variables d'environnement ───
# Copier ce fichier en .env et adapter les valeurs

# Base de données SQLite (chemin absolu ou relatif au dossier backend/)
PATRIMON_DB_PATH=./patrimoines.db

# Serveur
PATRIMON_HOST=0.0.0.0
PATRIMON_PORT=8000

# CORS — origines autorisées (séparées par des virgules)
# En dev : *   |  En prod : http://192.168.1.45:5173,http://localhost:5173
PATRIMON_CORS_ORIGINS=*

# Cache des cotations (en secondes)
PATRIMON_CACHE_TTL=60
PATRIMON_CURRENCY_CACHE_TTL=600
